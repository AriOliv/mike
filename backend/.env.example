PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: a remote OpenAI-compatible endpoint (a hosted gateway or proxy such
# as LiteLLM, OpenRouter, Together, Azure OpenAI, or your own service). When
# CUSTOM_OPENAI_BASE_URL is set, its models appear under a "Custom" group in the
# model picker and are selectable as "custom/<model>".
# CUSTOM_OPENAI_BASE_URL=https://your-gateway.example.com/v1
# CUSTOM_OPENAI_API_KEY=your-endpoint-api-key
# CUSTOM_OPENAI_MODEL=your-default-model

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# Optional: mirror the contract pipeline to a Notion board (server-side, one
# internal integration — no per-user OAuth). Create an internal integration in
# your workspace, share ONE page (or an existing database) with it, and put its
# id below: the app creates and maintains "Pipeline — Mike" under that page.
# Unset either value and the mirror stays off.
# NOTION_TOKEN=your-internal-integration-secret
# NOTION_PARENT_ID=the-shared-page-or-database-id
# NOTION_SYNC_SECONDS=300
# Base URL used for the "Open in app" link on each Notion card.
# APP_BASE_URL=http://localhost:3000

# Optional: mirror project documents to a shared Google Drive folder, so the
# team can open contracts where they already work. Uses one service account:
# put its JSON key somewhere the backend can read, share the target folder with
# the service account's email (Editor), and set the folder id. The mirror
# creates one subfolder per project. Unset either value and it stays off.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/sa.json
# DRIVE_FOLDER_ID=the-shared-drive-folder-id
# DRIVE_SYNC_SECONDS=300

# Optional: mirror radar deadlines onto a shared Google Calendar, using the same
# service account. Share the calendar with the service account's email ("make
# changes to events") and put its id here. Unset it and the mirror stays off.
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# CALENDAR_SYNC_SECONDS=300

# Optional: Ed25519 seed used to sign project export manifests, so a recipient
# can tell an untouched manifest from an edited one. Leave it unset to export
# unsigned manifests: the file hashes are still there, the manifest itself is
# just unattested.
# Generate with: openssl rand -hex 32
# Use a dedicated secret. The matching public key is served at
# GET /manifest-signing-key. Rotating the key does not invalidate past exports,
# but whoever checks one needs the key that was current when it was made.
MANIFEST_SIGNING_KEY=
